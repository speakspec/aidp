{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.speakspec.com/schema/v0.2.0.json",
  "title": "AIDP Document v0.2.0",
  "description": "JSON Schema for the AIDP (AI Directive Protocol) public response document, version 0.2.0. See https://docs.speakspec.com/spec/ for the full prose specification.",
  "type": "object",
  "required": ["$schema", "$aidp", "entity", "directives", "verification", "content", "community", "extensions", "meta"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "URI pointing to the JSON Schema describing this document."
    },
    "$aidp": {
      "type": "string",
      "description": "AIDP spec version (SemVer).",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entity": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Entity identifier. Either a URN (urn:aidp:entity:*) or a W3C DID (did:web:*, did:key:*, did:wba:*)."
        },
        "type": {
          "type": "string",
          "enum": ["organization", "business", "government", "academic", "media", "individual", "bot"],
          "description": "Semantic entity type. Source: aidp-docs/spec/entity.md field reference table."
        },
        "name": {
          "type": ["object", "string"],
          "description": "Entity display name. Object for multilingual (locale keys), string for single-locale."
        },
        "description": {
          "type": ["object", "string", "null"]
        },
        "domain": {
          "type": ["string", "null"]
        },
        "locale": {
          "type": "string"
        },
        "category": {
          "type": "array",
          "items": { "type": "string" }
        },
        "market": {
          "type": ["string", "null"]
        },
        "variant_of": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": true
    },
    "directives": {
      "type": "object",
      "properties": {
        "freshness": {
          "type": "object",
          "properties": {
            "default_ttl": {
              "type": "integer",
              "minimum": 0,
              "description": "Default time-to-live in seconds."
            },
            "stale_action": {
              "type": "string",
              "enum": ["warn", "hide", "fallback"],
              "description": "Agent behaviour when content is stale. Source: aidp-docs/spec/directives.md freshness field table."
            }
          },
          "additionalProperties": true
        },
        "access_control": {
          "type": "object",
          "properties": {
            "allow_caching":       { "type": "boolean" },
            "allow_training":      { "type": "boolean" },
            "allow_derivative":    { "type": "boolean" },
            "require_attribution": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "interaction": {
          "type": "object",
          "additionalProperties": true
        },
        "ai_behavior": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["methods", "trust_score", "trust_level"],
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "status"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "dns_txt",
                  "dns_cname",
                  "meta_tag",
                  "business_registration",
                  "domain_whois",
                  "email_domain",
                  "social_verification",
                  "manual_review",
                  "third_party",
                  "verifiable_credential"
                ],
                "description": "Verification method type. Source: aidp-docs/spec/verification.md Verification Methods table."
              },
              "status": {
                "type": "string",
                "description": "Verification method status. Common values include: verified, pending, failed, expired. Spec does not enforce a closed enum; implementations may extend."
              },
              "verified_at": {
                "type": ["string", "null"],
                "format": "date-time"
              }
            },
            "additionalProperties": true
          }
        },
        "trust_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Computed trust score between 0 and 1."
        },
        "trust_level": {
          "type": "string",
          "enum": ["unverified", "claimed", "verified_domain", "verified_organization", "institutional", "sovereign"],
          "description": "Derived trust level enum. Source: aidp-docs/spec/verification.md Trust Levels table."
        },
        "last_verified": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "credential": {
          "type": ["object", "null"],
          "description": "Optional W3C Verifiable Credential 2.0.",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "data", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "description": "Content type. Standard values per spec/content.md include: service, product, article, faq, event, person, menu_item, policy, announcement, dataset, media. Spec also permits custom types — schema does not enforce a closed enum."
          },
          "schema": {
            "type": "string",
            "description": "AIDP schema identifier (e.g. aidp:service, aidp:media)."
          },
          "data": {
            "type": ["object", "array", "string", "null"]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "media_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "community": {
      "type": "object",
      "required": ["disputes", "integrity_score"],
      "properties": {
        "disputes": {
          "type": "object",
          "required": ["total", "resolved", "pending", "rejected"],
          "properties": {
            "total":    { "type": "integer", "minimum": 0 },
            "resolved": { "type": "integer", "minimum": 0 },
            "pending":  { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "integrity_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "null when insufficient community data (typically disputes.total = 0 and no interaction history); 0.0 when computed minimum; >0 otherwise. See spec section community / integrity_score null semantics."
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": ["object", "array", "null"],
      "description": "Vendor or platform extensions. No schema constraints imposed."
    },
    "meta": {
      "type": "object",
      "required": ["generated_at", "platform"],
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "platform": {
          "type": "object",
          "required": ["id", "name", "url"],
          "properties": {
            "id":   { "type": "string" },
            "name": { "type": "string" },
            "url":  { "type": "string", "format": "uri" }
          },
          "additionalProperties": true
        },
        "spec_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
